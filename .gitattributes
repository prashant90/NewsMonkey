# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Mark all JS/TS/JSON/HTML/CSS files as text with LF endings
*.js     text eol=lf
*.jsx    text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.json   text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.scss   text eol=lf

# Ensure markdown and docs are LF
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf

# Binary files (don’t modify line endings)
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.zip    binary
*.exe    binary
*.ttf    binary
*.woff   binary
*.woff2  binary
